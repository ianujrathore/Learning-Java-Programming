package Codeforces_Problem;

import java.util.*;

public class Problem1840A {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            String s = sc.next();
            StringBuilder ans = new StringBuilder();

            int i = 0;
            while (i < n) {
                char c = s.charAt(i);
                ans.append(c);
                i++;

                while (i < n && s.charAt(i) != c) {
                    i++;
                }

                i++;
            }

            System.out.println(ans);
        }

        sc.close();
    }
}
