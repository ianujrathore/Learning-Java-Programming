package Codeforces_Problem;

import java.util.*;

public class Problem1560B {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int a = sc.nextInt();
            int b = sc.nextInt();
            int c = sc.nextInt();

            int n = 2 * Math.abs(a - b);

            if (a > n || b > n || c > n) {
                System.out.println(-1);
                continue;
            }

            int d = c + n / 2;

            if (d > n) {
                d -= n;
            }

            System.out.println(d);
        }

        sc.close();
    }
}
