package Codeforces_Problem;

import java.util.*;

public class Problem2131A {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            int[] a = new int[n];

            for (int i = 0; i < n; i++) {
                a[i] = sc.nextInt();
            }

            int ans = 1;

            for (int i = 0; i < n; i++) {
                int b = sc.nextInt();
                if (a[i] > b) {
                    ans += a[i] - b;
                }
            }

            System.out.println(ans);
        }
    }
}
