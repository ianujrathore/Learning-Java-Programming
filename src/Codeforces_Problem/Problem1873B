package Codeforces_Problem;

import java.util.*;

public class Problem1873B {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            int[] a = new int[n];

            int min = Integer.MAX_VALUE;

            for (int i = 0; i < n; i++) {
                a[i] = sc.nextInt();
                min = Math.min(min, a[i]);
            }

            long ans = 1;

            for (int i = 0; i < n; i++) {
                if (a[i] == min) {
                    ans *= (a[i] + 1);
                    min = Integer.MIN_VALUE;
                } else {
                    ans *= a[i];
                }
            }

            System.out.println(ans);
        }
    }
}
