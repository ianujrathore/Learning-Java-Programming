package Codeforces_Problem;

import java.util.*;

public class Problem1933A {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            int sum = 0;

            for (int i = 0; i < n; i++) {
                sum += Math.abs(sc.nextInt());
            }

            System.out.println(sum);
        }
    }
}
