package Codeforces_Problem;

import java.util.*;

public class Problem2218A {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int x = sc.nextInt();
            System.out.println(Math.min(x + 1, 67));
        }

        sc.close();
    }
}
