package Codeforces_Problem;

import java.util.*;

public class Problem1186A {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int m = sc.nextInt();
        int k = sc.nextInt();

        System.out.println(m >= n && k >= n ? "Yes" : "No");
    }
}
