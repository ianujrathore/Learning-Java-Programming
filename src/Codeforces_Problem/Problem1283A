package Codeforces_Problem;

import java.util.*;

public class Problem1283A {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int h = sc.nextInt();
            int m = sc.nextInt();

            System.out.println(1440 - (h * 60 + m));
        }
    }
}
