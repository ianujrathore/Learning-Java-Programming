package Codeforces_Problem;

import java.util.*;

public class Problem1633A {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();

            if (n % 7 == 0) {
                System.out.println(n);
            } else {
                int x = n - n % 10;
                for (int d = 0; d <= 9; d++) {
                    int num = x + d;
                    if (num % 7 == 0) {
                        System.out.println(num);
                        break;
                    }
                }
            }
        }
    }
}
